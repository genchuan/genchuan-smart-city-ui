# 应用标题
VITE_APP_TITLE=智慧城市一网统管AI平台
VITE_COMPANY_NAME=福建亘川科技有限公司
VITE_COMPANY_SiteLink=http://genchuan.cn

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=yudao-vben-ele

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 是否开启模拟数据
VITE_NITRO_MOCK=false

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 百度统计
VITE_APP_BAIDU_CODE = yourtoken

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# API 加解密
VITE_APP_API_ENCRYPT_ENABLE = true
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY = yourtoken
VITE_APP_API_ENCRYPT_RESPONSE_KEY = yourtoken

# Coze AI 配置
VITE_COZE_BOT_ID=yourtoken
VITE_COZE_TOKEN=yourtoken
VITE_COZE_TITLE=AI助手

# ThingsBoard 配置
VITE_THINGS_BOARD_URL='http://127.0.0.1:8080/'
VITE_THINGS_BOARD_NAME='username'
VITE_THINGS_BOARD_PASSWORD='password'
VITE_USER_NODE_ENV=development
